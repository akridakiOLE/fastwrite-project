/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/style.css
  Cache-Control: public, max-age=86400

# ── Hand Control (25/8/2026) ────────────────────────────────────────
# Το /* πιο πάνω κλείνει την κάμερα σε ΟΛΟ το site (camera=()). Το Hand
# Control είναι εφαρμογή κάμερας — χωρίς αυτό το μπλοκ, το getUserMedia
# απορρίπτεται από τον browser πριν καν ρωτήσει τον χρήστη.
# Ανοίγει ΜΟΝΟ για το /hc/, ΜΟΝΟ για την ίδια προέλευση (self).
/hc/*
  Permissions-Policy: camera=(self), geolocation=(), microphone=()
  Cache-Control: no-cache

/hc/icons/*
  Cache-Control: public, max-age=604800
