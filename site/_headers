/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/style.css
  Cache-Control: public, max-age=86400

# ── Kostometro (25/8/2026 · μετονομασίες 31/8 και 1/9/2026) ────────
# Το /* πιο πάνω κλείνει την κάμερα σε ΟΛΟ το site (camera=()). Το
# Kostometro είναι εφαρμογή κάμερας — χωρίς αυτό το μπλοκ, το
# getUserMedia απορρίπτεται από τον browser πριν καν ρωτήσει τον χρήστη.
# Ανοίγει ΜΟΝΟ για το /kostometro/, ΜΟΝΟ για την ίδια προέλευση (self).
/kostometro/*
  Permissions-Policy: camera=(self), geolocation=(), microphone=()
  Cache-Control: no-cache

/kostometro/icons/*
  Cache-Control: public, max-age=604800

# Οι παλιές διαδρομές /hc/ και /kostometrisi/ — μόνο σελίδα μετακόμισης
# και service worker αυτοκαταστροφής. Καμία κάμερα, καμία cache.
# ⚠ Τα δεδομένα των χρηστών ΔΕΝ επηρεάζονται: IndexedDB και localStorage
# ζουν στην ΠΡΟΕΛΕΥΣΗ (fastwrite.tech), όχι στη διαδρομή.
/hc/*
  Cache-Control: no-store

/kostometrisi/*
  Cache-Control: no-store
