/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/style.css
  Cache-Control: public, max-age=86400

# ── Kostometrisi (25/8/2026 · μετονομασία 31/8/2026) ────────────────
# Το /* πιο πάνω κλείνει την κάμερα σε ΟΛΟ το site (camera=()). Το
# Kostometrisi είναι εφαρμογή κάμερας — χωρίς αυτό το μπλοκ, το
# getUserMedia απορρίπτεται από τον browser πριν καν ρωτήσει τον χρήστη.
# Ανοίγει ΜΟΝΟ για το /kostometrisi/, ΜΟΝΟ για την ίδια προέλευση (self).
/kostometrisi/*
  Permissions-Policy: camera=(self), geolocation=(), microphone=()
  Cache-Control: no-cache

/kostometrisi/icons/*
  Cache-Control: public, max-age=604800

# Η παλιά διαδρομή /hc/ — μόνο σελίδα μετακόμισης και service worker
# αυτοκαταστροφής. Καμία κάμερα, καμία cache.
/hc/*
  Cache-Control: no-store
